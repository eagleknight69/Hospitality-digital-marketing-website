# Server configuration
PORT=4000

# Google Gemini API key for live AI Hospitality Growth Audits (/api/audit).
# Leave unset to run in preview mode with a curated fallback report.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Gemini model override (defaults to gemini-2.5-flash when unset)
GEMINI_MODEL=gemini-2.5-flash
